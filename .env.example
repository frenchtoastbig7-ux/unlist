# Copy to .env (gitignored). The MCP server and CLI read this file at start.

# Where the database, evidence and reports live. Default: ~/.unlist
# UNLIST_DATA_DIR=/Users/you/.unlist

# Have I Been Pwned: optional. Without a key only the public breach list and
# Pwned Passwords (k-anonymity) are used. Core 1 is enough for one person.
# HIBP_API_KEY=

# LeakCheck Pro: optional. Enables phone-number lookups in combolists. That API returns
# leaked values; unlist keeps the source and the names of the exposed fields and drops
# every value before anything is stored.
# LEAKCHECK_API_KEY=

# Brave Search API: optional. Enables web-mention searches (about 1,000 free queries a
# month; a card is required to sign up). Results are shown, never stored.
# BRAVE_API_KEY=

# How many approved email requests may go out per day (default 40). A large approved
# batch is sent over several days so the mailbox is not flagged.
# UNLIST_SEND_DAILY_CAP=40

# Dedicated mailbox for opt-out requests (create one for this; never your main account).
# UNLIST_SMTP_HOST=smtp.example.com
# UNLIST_SMTP_PORT=587
# UNLIST_SMTP_USER=optouts@example.com
# UNLIST_SMTP_PASSWORD=
# UNLIST_IMAP_HOST=imap.example.com
# UNLIST_IMAP_PORT=993
# UNLIST_FROM_NAME=
